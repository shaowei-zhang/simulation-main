<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.topo.mapper.ComponentCatalogMapper">

    <resultMap id="BaseResultMap" type="com.example.topo.domain.ComponentCatalog">
            <id property="id" column="id" jdbcType="BIGINT"/>
            <result property="catalogJson" column="catalog_json" jdbcType="VARCHAR"/>
            <result property="category" column="category" jdbcType="VARCHAR"/>
            <result property="description" column="description" jdbcType="VARCHAR"/>
            <result property="kind" column="kind" jdbcType="VARCHAR"/>
            <result property="name" column="name" jdbcType="VARCHAR"/>
            <result property="updatedAt" column="updated_at" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,catalog_json,category,
        description,kind,name,
        updated_at
    </sql>
</mapper>
